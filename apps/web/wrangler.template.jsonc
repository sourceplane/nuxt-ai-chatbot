// The source of wrangler.jsonc, which tooling/wire renders from it: from
// wiring.fixture.json for local work (`pnpm run wire:fixture`, committed as
// that render), and on every Orun lane from the wiring documents the
// `cloudflare-d1` and `cloudflare-r2` Terraform roots lease-publish
// (WIRING_CLOUDFLARE_D1_<ENV>, WIRING_CLOUDFLARE_R2_<ENV>) — dev, which no
// root applies to, from the fixture (component.yaml's buildCommand). Edit this
// file, never wrangler.jsonc. The workers-assets composition deploys one
// environment per job with no wrangler `--env`, so `__ENV__` names the
// environment this is rendered for.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuxt-ai-chatbot-web",
  // Nitro's cloudflare_module output: the Worker, and the static assets it
  // serves beside it.
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // The chats, their messages, the users and the votes — Cloudflare D1
  // (NuxtHub's `d1` driver, `hub:db`) in place of Turso. The schema is
  // packages/db's migrations, applied before the Worker deploys.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "@@wiring(cloudflare-d1/__ENV__:d1_database_name)@@",
      "database_id": "@@wiring(cloudflare-d1/__ENV__:d1_database_id)@@"
    }
  ],
  // The uploads — an R2 bucket (NuxtHub's `cloudflare-r2` driver, `hub:blob`)
  // in place of Vercel Blob, served back at /api/files/<pathname>.
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "@@wiring(cloudflare-r2/__ENV__:r2_bucket_name)@@"
    }
  ],
  // The model provider. Workers AI through this binding is the default for
  // the chat and the titles (server/utils/models.ts): it needs no key — the
  // Worker's own account runs the models. Workers AI has no local mode, so
  // `wrangler dev` and `nuxt dev` reach it remotely (`wrangler login` first).
  "ai": {
    "binding": "AI"
  }
  // NUXT_SESSION_PASSWORD, NUXT_OAUTH_GITHUB_CLIENT_ID,
  // NUXT_OAUTH_GITHUB_CLIENT_SECRET and AI_GATEWAY_API_KEY are optional
  // Worker SECRETS, never vars: the product's Orun secrets of the same names,
  // which the deploy sets on the Worker (component.yaml, README). Without the
  // first, the session key is the one the database generated
  // (server/utils/app-secrets.ts); without the GitHub pair the chat works
  // without sign-in; without the gateway key only Workers AI's models are
  // offered and dictation is off.
}
