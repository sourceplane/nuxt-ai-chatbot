{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Nuxt UI chat template \u2014 streaming AI chat with history, uploads and GitHub sign-in \u2014 on Cloudflare Workers, D1, R2 and Workers AI.",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler dev",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "db:generate": "nuxt db generate",
    "db:migrate:local": "node ../../tooling/migrations/local.mjs",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.88",
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/openai": "4.0.102",
    "@ai-sdk/vue": "4.0.153",
    "@comark/nuxt": "0.8.1",
    "@iconify-json/logos": "1.2.17",
    "@iconify-json/lucide": "1.2.147",
    "@iconify-json/simple-icons": "1.2.100",
    "@nuxt/ui": "4.12.0",
    "@nuxthub/core": "0.10.11",
    "@shikijs/langs": "4.5.0",
    "@tanstack/charts": "1.1.0",
    "@vueuse/core": "14.4.0",
    "ai": "7.0.153",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "h3": "1.15.11",
    "motion-v": "2.8.0",
    "nuxt": "4.6.2",
    "nuxt-auth-utils": "0.5.32",
    "nuxt-csurf": "1.6.6",
    "shiki": "4.5.0",
    "striptags": "3.2.0",
    "tailwindcss": "4.3.3",
    "workers-ai-provider": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "rolldown": "1.2.12",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13",
    "wrangler": "4.151.0"
  }
}
